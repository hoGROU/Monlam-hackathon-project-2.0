# ---- Monlam AI (OCR, chat, speech-to-text, text-to-speech) ----
MONLAM_API_KEY=your_monlam_api_key_here
MONLAM_BASE_URL=https://api.monlam.ai

# ---- Anthropic (translation, summary, keyword extraction) ----
# Optional: if omitted, the backend falls back to the Monlam chat model.
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# ---- CORS ----
# Comma separated list of frontend origins allowed to call this API.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
